# Copy to .env (setup.sh does it) and edit. Used by docker-compose.yml.

# Address of the server. Without a domain name, use the server's IP address with sslip.io:
# IP 203.0.113.7 -> 203-0-113-7.sslip.io (it gets a real HTTPS certificate)
SITE_ADDRESS=203-0-113-7.sslip.io
PUBLIC_URL=https://203-0-113-7.sslip.io

# Jobs are deleted this many days after they end (0 = never)
RETENTION_DAYS=7
# A keyword that matches more PDB entries than this is refused before anything is downloaded.
# Measured (4 CPUs): triosephosphate isomerase, 262 entries: 8.5 min, 1 GB. HIV-1 protease, 684 entries
# (828 entities: many ligands): over 45 min and 9 GB in Step 4. Cost depends on entities more than entries.
MAX_ENTRIES=400
# At most this many computed models (AlphaFold DB) per job
MAX_CSM=200
# A job still running after this many hours is stopped
JOB_TIMEOUT_HOURS=2

# Memory of the CIFcurator container (leave about 3 GB of the server for the rest)
MEM_LIMIT=13g

# Other server options, e.g. --show-recent-jobs (the list of everybody's jobs; fine for a demo
# among colleagues) or the email settings (--smtp-host ... --mail-from ...)
EXTRA_ARGS=

# Written by update.sh / setup.sh: commit of the code in the image
CIFCURATOR_COMMIT=unknown
